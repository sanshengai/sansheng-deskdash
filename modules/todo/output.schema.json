{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "todo 采集器输出契约(扁平标量;键不带 prefix)",
  "description": "Row1..Row6 为固定槽位(对应 band.inc 6 行);未用槽位透明。Config/Pyw/Script 为交互脚本要用的部署变量(本机运行时算出,只落 data.inc)。字段只增不删。",
  "type": "object",
  "required": ["Count"],
  "properties": {
    "Count": {"type": "integer", "minimum": 0, "description": "待办条数(可超 6,band 只显示前 6)。"},
    "Title": {"type": "string"},
    "AddLabel": {"type": "string"},
    "DelIcon": {"type": "string"},
    "Config": {"type": "string", "description": "皮肤 config 名(交互后 !Refresh 定向刷新;空=全刷)。"},
    "Pyw": {"type": "string", "description": "pythonw.exe 绝对路径(band Action 启动交互脚本用)。"},
    "Script": {"type": "string", "description": "todo_action.py 绝对路径。"},

    "Row1Text": {"type": "string"}, "Row1Done": {"type": "integer", "minimum": 0, "maximum": 1},
    "Row1Mark": {"type": "string"}, "Row1Color": {"type": "string"},
    "Row1Check": {"type": "string"}, "Row1DelColor": {"type": "string"},

    "Row2Text": {"type": "string"}, "Row2Done": {"type": "integer", "minimum": 0, "maximum": 1},
    "Row2Mark": {"type": "string"}, "Row2Color": {"type": "string"},
    "Row2Check": {"type": "string"}, "Row2DelColor": {"type": "string"},

    "Row3Text": {"type": "string"}, "Row3Done": {"type": "integer", "minimum": 0, "maximum": 1},
    "Row3Mark": {"type": "string"}, "Row3Color": {"type": "string"},
    "Row3Check": {"type": "string"}, "Row3DelColor": {"type": "string"},

    "Row4Text": {"type": "string"}, "Row4Done": {"type": "integer", "minimum": 0, "maximum": 1},
    "Row4Mark": {"type": "string"}, "Row4Color": {"type": "string"},
    "Row4Check": {"type": "string"}, "Row4DelColor": {"type": "string"},

    "Row5Text": {"type": "string"}, "Row5Done": {"type": "integer", "minimum": 0, "maximum": 1},
    "Row5Mark": {"type": "string"}, "Row5Color": {"type": "string"},
    "Row5Check": {"type": "string"}, "Row5DelColor": {"type": "string"},

    "Row6Text": {"type": "string"}, "Row6Done": {"type": "integer", "minimum": 0, "maximum": 1},
    "Row6Mark": {"type": "string"}, "Row6Color": {"type": "string"},
    "Row6Check": {"type": "string"}, "Row6DelColor": {"type": "string"}
  },
  "additionalProperties": false
}
