{
  "display": {
    "id": "todo",
    "name": "待办清单",
    "name_en": "Todo",
    "version": "0.1.0",
    "author": "sansheng",
    "license": "MIT",
    "category": "tasks",
    "screenshot": "screenshot.png",
    "tags": ["todo", "tasks", "checklist", "interactive"]
