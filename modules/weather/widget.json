{
  "display": {
    "id": "weather",
    "name": "天气",
    "name_en": "Weather",
    "version": "0.1.0",
    "author": "sansheng",
    "license": "MIT",
    "category": "weather",
    "screenshot": "screenshot.png",
    "tags": ["weather", "forecast", "open-meteo", "caiyun"]
  },
  "runtime": {
    "entry": "collector.py",
    "refresh": {"mode": "interval", "interval_s": 3600, "net_only_ok": true},
    "timeout_s": 60,
    "deps": [],
    "output": {"prefix": "Wx", "schema": "output.schema.json"},
    "config": {"schema": "config.schema.json", "example": "config.example.json", "secrets": ["caiyun_token"]},
    "privacy": {"network": ["api.open-meteo.com", "api.caiyunapp.com", "ip-api.com", "geocoding-api.open-meteo.com"], "local_read": [], "local_write": []},
    "band": {"file": "band.inc", "height": 150, "interactive": false}
  }
}
