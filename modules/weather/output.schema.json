      "type": "string"
    },
    "Provider": {
      "type": "string"
    },
    "UpdatedAt": {
      "type": "string"
    },
    "NowTempText": {
      "type": "string"
    },
    "NowDesc": {
      "type": "string"
    },
    "NowSummary": {
      "type": "string"
    },
    "MaxPath": {
      "type": "string",
      "description": "tmax 贝塞尔 Path 字符串(相对曲线 meter 原点)。"
    },
    "MinPath": {
      "type": "string",
      "description": "tmin 贝塞尔 Path 字符串。"
    },
    "Col1X": {"type": "integer", "description": "第1列中心 x(几何单源:collector.COLS_X→band #WxCol1X#)。"},
