{
  "display": {
    "id": "server-status",
    "name": "服务状态",
    "name_en": "Server Status",
    "version": "0.1.0",
    "author": "sansheng",
    "license": "MIT",
    "category": "system",
    "screenshot": "screenshot.png",
    "tags": ["server", "uptime", "health", "http", "ping"]
  },
  "runtime": {
    "entry": "collector.py",
    "refresh": {"mode": "interval", "interval_s": 300, "net_only_ok": true},
    "timeout_s": 90,
    "deps": [],
    "output": {"prefix": "Srv", "schema": "output.schema.json"},
    "config": {"schema": "config.schema.json", "example": "config.example.json", "secrets": []},
    "privacy": {"network": ["<user-configured>"], "local_read": [], "local_write": []},
    "band": {"file": "band.inc", "height": 150, "interactive": false}
  }
}
