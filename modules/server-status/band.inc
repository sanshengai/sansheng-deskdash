; server-status 带区(局部 Y,原点在带区顶;装配整体平移落位)。
; 段名带 Srv 前缀;中文(标题/超时)与主机名一律走 #变量#(data.inc/UTF-16,GBK 桥),不在本文件内联。
; 每行:左=主机名,右=状态文本(HTTP "200 · 84ms" / ping "84 ms" / "超时"),随行状态色 #SrvHost{n}Color#。

[SrvCard]
Meter=Shape
Shape=Rectangle #PAD#,0,(#W#-2*#PAD#),150,8 | FillColor #cCardBg# | StrokeWidth 1 | StrokeColor #cCardLine#
DynamicVariables=1

[SrvHd]
Meter=String
X=#PAD#
Y=6
FontFace=#Font#
FontSize=#SizeM#
FontColor=#cHead#
StringStyle=Bold
AntiAlias=1
DynamicVariables=1
Text=#SrvTitle#

; —— 主机 5 行(行 Y = 34 + (i-1)*24)——
[SrvL1]
Meter=String
X=#PAD#
Y=34
W=230
ClipString=1
FontFace=#Font#
FontSize=#SizeS#
FontColor=#cText#
AntiAlias=1
DynamicVariables=1
Text=#SrvHost1Label#
[SrvV1]
Meter=String
X=404
Y=34
StringAlign=Right
FontFace=#Font#
FontSize=#SizeS#
FontColor=#SrvHost1Color#
AntiAlias=1
DynamicVariables=1
Text=#SrvHost1Text#

